{
  "name": "resume-gauge",
  "version": "0.1.0",
  "private": true,
  "description": "ResumeGauge - deterministic, privacy-first resume score checker.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
